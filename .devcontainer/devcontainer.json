{
  "name": "Full Stack Super Cart Prediction App",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "runServices": ["backend", "frontend"],
  "workspaceFolder": "/workspace",
  "forwardPorts": ["backend:7860", "frontend:8501"],
  "postStartCommand": "cd /workspace/Backend_Deployment && gunicorn -w 4 -b 0.0.0.0:7860 app:superkart_api --daemon"
}
